<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		El sitio del colegio, de donde cuelga la API. Vive acá y no en el código
		para que apuntar la app a un entorno de prueba sea cambiar un valor y no
		salir a buscar la URL por los archivos.
	-->
	<key>CeadSitio</key>
	<string>https://cead.edu.py</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>FondoLanzamiento</string>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!--
		Sin excepciones de transporte: la app manda una contraseña y carga un
		token de larga vida, así que HTTP en claro no se habilita para nada. El
		servidor además rechaza el login fuera de HTTPS, de modo que una
		excepción acá tampoco serviría para «probar rápido».
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
