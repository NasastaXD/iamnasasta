# ================================================================
# CEAD Académico — Bridge de WhatsApp — Configuración
# Copie este archivo como .env y complete los valores.
# El SHARED_TOKEN debe coincidir con WordPress:
#   CEAD Académico → WhatsApp → Configuración → Token compartido
# ================================================================

# Puerto local en el que correrá el bridge
PORT=3000

# --- Solo para VPS / servidor (dejar comentado en una PC del colegio) --------
# HOST: interfaz donde escucha. En una VPS detrás de nginx poné 127.0.0.1 para
# que el puerto NO quede abierto a internet (entra todo por el proxy con HTTPS).
# HOST=127.0.0.1
#
# PORT_STRICT: con el puerto fijo detrás de un proxy, si está ocupado conviene
# que falle a la vista en vez de correrse solo a otro puerto (el proxy quedaría
# apuntando a la nada).
# PORT_STRICT=1
#
# TUNNEL: apagá Cloudflare Tunnel si ya tenés dominio propio + nginx.
# TUNNEL=off
# ----------------------------------------------------------------------------

# Nivel de log de Baileys. Por defecto no muestra nada (su salida es enorme).
# Para diagnosticar problemas de conexión o de descifrado:
#   LOG_LEVEL=warn   → errores de sesión y reintentos
#   LOG_LEVEL=debug  → todo (mucho volumen, dejalo solo un rato)
# LOG_LEVEL=warn

# Token secreto compartido con el plugin WordPress.
# Genere uno aleatorio, por ejemplo con: openssl rand -hex 32
SHARED_TOKEN=cambie-esto-por-un-token-seguro

# URL del webhook de WordPress (la ruta NO cambia; solo reemplace el dominio).
# Ejemplo: https://TU-SITIO/wp-json/caag-bot/v1/incoming
WP_WEBHOOK_URL=https://TU-SITIO/wp-json/caag-bot/v1/incoming

# Demora en milisegundos antes de responder (simula "escribiendo...").
# Recomendado entre 1000 y 1800.
TYPING_DELAY_MS=1500

# Cuánto espera el bridge a que WordPress responda antes de cancelar (ms).
# WP_TIMEOUT_MS: mensajes de texto (la IA tarda unos segundos).
# WP_TIMEOUT_AUDIO_MS: notas de voz (se transcriben + responde la IA → más lento).
WP_TIMEOUT_MS=45000
WP_TIMEOUT_AUDIO_MS=120000
